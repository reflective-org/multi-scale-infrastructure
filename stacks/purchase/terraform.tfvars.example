# Copy to terraform.tfvars (gitignored) and edit.
# Variables are defined in variables.tf; see README and docs/runbooks.md
# for the full purchase workflow before applying anything.
#
# Workflow: search (free) -> review outputs -> confirm (SPENDS MONEY)
#           -> purchase applies -> search_enabled = false (required final step).

# ---------------------------------------------------------------------------
# Search inputs (free — searching creates nothing and costs nothing)
# ---------------------------------------------------------------------------

region = "us-east-1"

# Exactly one of: "p5.48xlarge" | "p5en.48xlarge".
#
# Region availability differs by instance type (as of 2026-08; AWS expands
# this over time — an EMPTY search result can mean "wrong region for this
# type", not "no capacity"). Mirrored in the README's "Region availability"
# table — keep both in sync:
#   both types: us-east-1, us-east-2, us-west-1, us-west-2, eu-north-1,
#               eu-west-2, ap-northeast-1, ap-south-1, ap-southeast-2,
#               ap-southeast-3
#   p5 only:    sa-east-1
#   p5en only:  eu-south-2, ap-northeast-2
instance_type = "p5.48xlarge"

# Instances in the block: 1-64.
instance_count = 1

# Whole days, in hours: >= 24 and a multiple of 24.
capacity_duration_hours = 24

# Optional window for the block, RFC3339.
# start_date_range = "2026-09-01T00:00:00Z"
# end_date_range   = "2026-09-08T00:00:00Z"

# ---------------------------------------------------------------------------
# !!! PURCHASE CONFIRMATION — REAL, NON-REFUNDABLE MONEY !!!
#
# Setting BOTH variables below and applying PURCHASES the capacity block:
# the full fee is charged UPFRONT, IMMEDIATELY, and is NON-REFUNDABLE.
# There is no cancellation, and destroying the resource does NOT refund —
# it only removes it from state.
#
# 1. Apply with both unset and review the offering outputs
#    (offering_id, offering_upfront_fee, offering_availability_zone, dates).
# 2. In the SAME session (offerings are ephemeral quotes), copy the reviewed
#    values into both variables below and apply again.
# The purchase is blocked unless a fresh lookup still shows the exact fee
# (and AZ, if pinned) you confirmed.
# ---------------------------------------------------------------------------

# capacity_block_offering_id = "cbo-0123456789abcdef0"
# expected_upfront_fee       = "28800.00"

# Optional extra pin: also verify the AZ against the fresh lookup.
# expected_availability_zone = "us-east-1a"

# ---------------------------------------------------------------------------
# Post-purchase (REQUIRED final step)
# ---------------------------------------------------------------------------

# After the purchase succeeds, set search_enabled = false so drifted or empty
# offering lookups can never block or disturb the existing reservation.
# search_enabled = false

# Tags applied to the reservation.
# tags = {
#   project = "multi-scale"
# }
