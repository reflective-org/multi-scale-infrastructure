# Copy to terraform.tfvars (gitignored) and edit.
# Variables are defined in variables.tf; see README and docs/runbooks.md
# for the full fleet workflow before applying anything.

region = "us-east-2"

# --- Networking ----------------------------------------------------------
# CIDR for the stack's self-contained VPC. Default is fine unless it
# collides with networks you plan to peer with.
# vpc_cidr = "10.0.0.0/16"
#
# Availability zone suffixes (appended to region); one public subnet per
# entry, and instances spread across them round-robin. Steer this list when
# an AZ has no g6e capacity — check offerings first (docs/runbooks.md):
#   aws ec2 describe-instance-type-offerings --location-type availability-zone
# subnet_azs = ["a", "b"]

# --- Admin SSH access (see docs/admin-access.md) -------------------------
# CLI-initiated `aws ec2-instance-connect ssh` and plain ssh connect from
# YOUR IP, so list it here (`curl -s ifconfig.me`, then /32). The browser
# console's EC2 Instance Connect needs no entry — the AWS service ranges
# are always admitted. IPv4 only; 0.0.0.0/0 and ::/0 are rejected by
# validation.
# admin_cidr_blocks = ["203.0.113.7/32"]

# --- Key pair (set exactly one of the two) --------------------------------
# Option A: register a new key pair from a local public key. Generate one
# with scripts/generate-key.sh — it prints this exact line. Only the public
# key is registered; the private key never leaves your machine.
# public_key = "ssh-ed25519 AAAA... you@host"
#
# Option B: reuse a key pair that already exists in this region.
# existing_key_pair_name = "my-existing-key"
#
# Name PREFIX used when registering public_key (a random suffix is appended
# so nothing collides with a p5 runtime deployment in the same region;
# ignored for option B):
# key_pair_name = "multi-scale-fleet"

# --- Workload image (REQUIRED) --------------------------------------------
# Container image every node runs. A private-ECR URI is detected by its
# shape (<account>.dkr.ecr.<region>.amazonaws.com/...): the instances get
# automatic ECR login at boot plus a pull policy scoped to exactly that
# repository, with the registry region taken from the URI itself — so a
# us-west-2 image works from a us-east-2 fleet. Any other registry
# (ghcr.io, public.ecr.aws, docker.io, ...) gets no ECR grant. Digest-pin
# (@sha256:...) so a partial replacement never runs a mixed-version fleet
# — see docs/runbooks.md.
# docker_image = "123456789012.dkr.ecr.us-east-2.amazonaws.com/train@sha256:<digest>"
# docker_image = "ghcr.io/org/train:v3"

# --- S3 data plane (bucket REQUIRED) ---------------------------------------
# Bare name of the bucket the containers use (not an s3:// URI; the bucket
# is yours, not managed by this stack). The instance role reads the whole
# bucket but writes ONLY under s3_output_prefix.
# s3_bucket = "my-training-data"
#
# Key prefix the containers may write under. Keep input data OUTSIDE this
# prefix — every fleet node can write (and overwrite) objects under it. No
# leading/trailing slash; nesting is fine ("runs/2026-09").
# s3_output_prefix = "outputs"

# --- Container logs --------------------------------------------------------
# Ship container stdout/stderr to CloudWatch Logs (awslogs driver). On by
# default; disabling also removes the role's logs: grant.
# enable_container_logs = true

# --- Tags ------------------------------------------------------------------
# Extra tags merged onto every resource.
# tags = { Owner = "you" }
